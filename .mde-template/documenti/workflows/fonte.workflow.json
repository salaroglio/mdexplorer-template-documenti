{
  "mde_workflow": 3,
  "title": "Una fonte nel wiki",
  "description": "Le fonti nuove portate nel wiki dal redattore, rilette dal revisore, accettate dal responsabile della documentazione.",
  "steps": [
    {
      "id": "fonte",
      "agent": "documenti-redattore",
      "skill": "inserisci-fonte",
      "title": "Porta le fonti nel wiki",
      "trigger": { "launch": true },
      "start": "manual"
    },
    {
      "id": "revisione",
      "agent": "documenti-revisore",
      "skill": "rivedi",
      "title": "Revisione",
      "trigger": { "after": ["fonte"] },
      "start": "auto",
      "inputs": {
        "pagine": { "from": "fonte.pagine" },
        "registro": { "from": "fonte.registro" }
      }
    },
    {
      "id": "decisione",
      "person": "Responsabile della documentazione",
      "title": "Accetta le pagine",
      "trigger": { "after": ["revisione"] },
      "task": "Leggi la revisione delle pagine nuove e decidi se entrano nel wiki così come sono.",
      "inputs": {
        "revisione": { "from": "revisione.revisione" }
      },
      "outcomes": [
        { "id": "accettate", "label": "Accettate" },
        { "id": "da-correggere", "label": "Da correggere" }
      ]
    }
  ],
  "loops": [
    { "id": "correzione", "steps": ["fonte", "revisione"], "until": "approved", "restart": "manual" }
  ]
}
